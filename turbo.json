{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "prisma:generate"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build",
        "prisma:generate"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "RUN_LIVE_AI_TESTS",
        "GEMINI_API_KEY",
        "GOOGLE_API_KEY",
        "GEMINI_TEST_MODEL"
      ]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "prisma:generate": {
      "cache": false,
      "env": [
        "DATABASE_URL",
        "DIRECT_URL"
      ]
    },
    "test:e2e": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "env": [
        "TEST_DATABASE_URL",
        "DATABASE_URL",
        "DIRECT_URL",
        "MASTER_ENCRYPTION_KEY",
        "SESSION_SECRET"
      ]
    }
  },
  "globalEnv": [
    "NODE_ENV"
  ],
  "globalDependencies": [
    ".env"
  ]
}
