{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "prisma:generate"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build",
        "prisma:generate"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "RUN_LIVE_AI_TESTS",
        "GEMINI_API_KEY",
        "GOOGLE_API_KEY",
        "GEMINI_TEST_MODEL"
      ]
    },
    "lint": {},
    // Same two dependencies as `build` and `typecheck`, for the same reason.
    // Without them `pnpm dev` started the API against an unbuilt `@cbd/ai` and an
    // ungenerated Prisma client — both git-ignored build artefacts — so `nest
    // start --watch` failed to compile, never bound port 3000, and sat in its
    // watch loop. The web app then reported the API as unreachable, which reads
    // as "the API crashed" rather than "the API was never built".
    "dev": {
      "dependsOn": [
        "^build",
        "prisma:generate"
      ],
      "cache": false,
      "persistent": true
    },
    "prisma:generate": {
      "cache": false,
      "env": [
        "DATABASE_URL",
        "DIRECT_URL"
      ]
    },
    "test:e2e": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "env": [
        "TEST_DATABASE_URL",
        "DATABASE_URL",
        "DIRECT_URL",
        "MASTER_ENCRYPTION_KEY",
        "SESSION_SECRET"
      ]
    }
  },
  "globalEnv": [
    "NODE_ENV"
  ],
  "globalDependencies": [
    ".env"
  ]
}
