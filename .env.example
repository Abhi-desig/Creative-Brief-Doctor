# Copy to .env and fill in. .env is git-ignored and must never be committed.
#
# Step 0 (the calibration spike) needs only GEMINI_API_KEY. Everything below
# that line is for the application and is not required until the API is
# scaffolded in step 7.

# ── Step 0: calibration spike ────────────────────────────────────────────────

# Google AI Studio key. Free tier is quota-limited rather than billed.
# Read the data-use terms for the tier you enable before pasting
# client-confidential briefs into it — free and paid tiers have historically
# differed on whether submitted content may be used to improve the product.
GEMINI_API_KEY=

# ── Application: infrastructure (validated at boot) ──────────────────────────
# No provider API key is required at boot. A fresh deploy boots
# healthy-but-degraded and reports NO_ACTIVE_PROVIDER until an admin
# configures one through the panel.

DATABASE_URL=            # pooled
DIRECT_URL=              # unpooled, migrations only
MASTER_ENCRYPTION_KEY=   # 32 bytes, base64. Losing it means re-entering every provider key.
ADMIN_EMAIL=
# argon2id, from `pnpm --filter @cbd/api hash-password`.
# SINGLE-QUOTE it: argon2 hashes contain `$`, which the shell expands if you
# ever `source .env`. dotenv strips the quotes, so quoting is safe either way.
ADMIN_PASSWORD_HASH=''
SESSION_SECRET=          # cookie encryption + bearer signing
CORS_ORIGIN=             # the web origin, exactly
PORT=3000

# ── Application: web ─────────────────────────────────────────────────────────

API_BASE_URL=            # server-only
NEXT_PUBLIC_APP_URL=     # for OG metadata on shared links

# ── Optional: first-boot provider seed (CI and fresh databases only) ─────────
# Skip these if the key is entered through the admin panel.

AI_BOOTSTRAP_PROVIDER=   # google
AI_BOOTSTRAP_API_KEY=
AI_BOOTSTRAP_MODEL=
